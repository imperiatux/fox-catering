# Fox Catering — environment variable reference
# -----------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
#
# ── Vercel (production) ─────────────────────────────────
# Set these in the Vercel dashboard: Settings → Environment Variables
#
# ── Docker (local) ──────────────────────────────────────
# Set these in a .env file at the repo root (also gitignored),
# or export them in your shell before running docker compose up.
# -----------------------------------------------------------

# Organizer admin password.
# Used server-side only to authenticate the protected admin routes.
# Minimum 16 characters recommended.
ADMIN_PASSWORD=

# ── Vercel / Upstash (production only) ──────────────────────────────────────
# Not needed when running with Docker (REDIS_URL is used instead).

# Vercel KV (Upstash Redis) — REST API endpoint.
# Found in: Vercel dashboard → Storage → your KV store → .env.local tab
KV_REST_API_URL=

# Vercel KV (Upstash Redis) — REST API token (read-write).
# Found in the same location as KV_REST_API_URL above.
KV_REST_API_TOKEN=

# ── Docker / local (non-Vercel) ──────────────────────────────────────────────
# When this variable is set, the app uses ioredis instead of @vercel/kv.
# docker-compose.yml sets this automatically to redis://redis:6379.
# For running the server locally without Docker:
#   REDIS_URL=redis://localhost:6379
REDIS_URL=

# ── OpenAI (menu image parsing) ──────────────────────────────────────────────
# Used by POST /api/admin/parse-menu to extract menu fields from a JPEG/PNG.
# Get your key at: https://platform.openai.com/api-keys
# If not set, the "Upload menu image" button returns a 500 error gracefully.
OPENAI_API_KEY=

# ── Cutoff time (optional) ────────────────────────────────────────────────────
# Hour and minute (Europe/Bucharest time) after which ordering is closed.
# Defaults to 10:30 if not set. Set to a future time to test after the normal cutoff.
# Examples: CUTOFF_HOUR=23 CUTOFF_MINUTE=59  (effectively disable cutoff)
#           CUTOFF_HOUR=10 CUTOFF_MINUTE=30  (default)
CUTOFF_HOUR=
CUTOFF_MINUTE=
